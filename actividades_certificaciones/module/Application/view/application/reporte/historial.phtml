                    <?php foreach ($reportes as $r): ?>

                        <?php
                        /** Ocultar Reporte (Admin) para roles 5,6,7 */


                        $tipoTexto = match ($r->tipo) {
                            0 => 'Actividad (Admin)',
                            1 => 'Reporte (Admin)',
                            2 => 'Constancia (Pend/Aprob)',
                            3 => 'Constancia Aprobados',
                            default => 'Desconocido',
                        };

                        $detalle = htmlspecialchars(json_encode([
                            'tipo'        => $tipoTexto,
                            'estudiante'  => $r->estudiante_nombre ?: '—',
                            'actividad'   => $r->actividad_nombre ?: '—',
                            'generadoPor' => $r->generado_por_nombre,
                            'rol'         => $r->rol_generador_nombre,
                            'correlativo' => $r->correlativo,
                        ]), ENT_QUOTES);

                        /** Ocultar botón SOLO si no hay datos */
                        $ocultarBoton = false;

                        ?>

                        <tr>
                            <td><?= $tipoTexto ?></td>

                            <td class="fw-semibold text-primary">
                                <?= $this->escapeHtml($r->correlativo) ?>
                            </td>

                            <td class="text-center">
                                <button
                                    class="btn btn-sm btn-outline-primary btn-detalles"
                                    data-detalles="<?= $detalle ?>">
                                    👁 Ver
                                </button>
                            </td>
                        </tr>

                    <?php endforeach; ?>

                    <?php if (empty($reportes)): ?>
                        <tr>
