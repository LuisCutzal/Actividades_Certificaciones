                <th>Créditos</th>
                <th>Detalles</th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($estudiantes as $e): ?>
                <?php
                switch ($e->estado_lista) {
                    case 1:
                        $estadoTexto = 'Aprobado';
                        $estadoClase = 'aprobado';
                        break;
                    case 2:
                        $estadoTexto = 'No realizada';
                        $estadoClase = 'rechazado';
                        break;
                    default:
                        $estadoTexto = 'Pendiente';
                        $estadoClase = 'pendiente';
                }

                $detalle = htmlspecialchars(json_encode([
                    'estudiante' => $e->estudiante_nombre,
                    'carnet' => $e->carnet,
                    'actividad' => $e->actividad_nombre,
                    'organizador' => $e->organizador_nombre,
                    'carrera' => $e->carrera_nombre,
                    'tipo' => ucfirst($e->tipo_participacion),
                    'creditos' => $e->credito,
                    'estado' => $estadoTexto,
                    'fechaActividad' => date('d/m/Y H:i', strtotime($e->fecha_actividad)),
                    'creado' => date('d/m/Y H:i', strtotime($e->creado)),
                    'aprobado' => $e->aprobado ? date('d/m/Y H:i', strtotime($e->aprobado)) : '—',
                    'rechazado' => $e->rechazado ? date('d/m/Y H:i', strtotime($e->rechazado)) : '—',
                    'motivo' => $e->motivo_rechazo ?: '—',
                ]), ENT_QUOTES);
                ?>
                <tr>
                    <td class="carnet"><?= $e->carnet ?></td>
                    <td><?= $this->escapeHtml($e->estudiante_nombre) ?></td>
                    <td><?= $this->escapeHtml($e->actividad_nombre) ?></td>
                    <td>
                        <span class="estado <?= $estadoClase ?>">
                            <?= $estadoTexto ?>
                        </span>
                    </td>
                    <td><?= $e->credito ?></td>
                    <td>
                        <button class="btn-detalles" data-detalles="<?= $detalle ?>">
                            Ver
                        </button>
                    </td>
                </tr>
            <?php endforeach; ?>
        </tbody>
    </table>

    <?= $this->partial('application/partials/pagination', [
        'paginator' => $estudiantes,
