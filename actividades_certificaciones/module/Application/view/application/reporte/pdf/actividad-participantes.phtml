<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">

    <style>
        body {
            font-family: DejaVu Sans, sans-serif;
            font-size: 11px;
        }

        h1 {
            text-align: center;
            margin-bottom: 5px;
        }

        .subtitle {
            text-align: center;
            margin-bottom: 12px;
            font-size: 10px;
        }

        .info {
            margin-bottom: 12px;
        }

        .info p {
            margin: 2px 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th, td {
            border: 1px solid #000;
            padding: 6px;
            font-size: 10px;
        }

        th {
            background-color: #f0f0f0;
        }

        .small {
            font-size: 9px;
        }

        .estado-aprobado {
            font-weight: bold;
        }

        .estado-pendiente {
            font-style: italic;
        }

        .estado-rechazado {
            font-weight: bold;
        }

        .motivo {
            border: 1px solid #000;
            padding: 6px;
            margin-top: 6px;
            font-size: 10px;
        }
    </style>
</head>

<body>

<h1>Lista de Estudiantes</h1>

<div class="subtitle">
    <strong>Nombre Actividad:</strong>
    <?= $this->escapeHtml($actividad->actividad_nombre) ?><br>

    <strong>Carrera:</strong>
    <?= $this->escapeHtml($actividad->carrera_nombre ?? '—') ?><br>

    <strong>Tipo de participación:</strong>
    <?= ucfirst($actividad->tipo_participacion) ?><br>

    <strong>Fecha de generación:</strong>
    <?= date('d/m/Y H:i') ?>
</div>

<div class="info">
    <p>
        <strong>Estado de la actividad:</strong>
        <?php if ((int)$actividad->estado_lista === 1): ?>
            <span class="estado-aprobado">Aprobada</span>
        <?php elseif ((int)$actividad->estado_lista === 2): ?>
            <span class="estado-rechazado">No realizada</span>
        <?php else: ?>
            <span class="estado-pendiente">Pendiente</span>
        <?php endif; ?>
    </p>

    <?php if ((int)$actividad->estado_lista === 1 && !empty($actividad->aprobado)): ?>
        <p>
            <strong>Fecha de aprobación:</strong>
            <?= date('d/m/Y H:i', strtotime($actividad->aprobado)) ?>
        </p>
    <?php endif; ?>

    <?php if ((int)$actividad->estado_lista === 2): ?>
        <p>
            <strong>Fecha de rechazo:</strong>
            <?= !empty($actividad->rechazado)
                ? date('d/m/Y H:i', strtotime($actividad->rechazado))
                : 'N/D'
            ?>
        </p>

        <?php if (!empty($actividad->motivo_rechazo)): ?>
            <div class="motivo">
                <strong>Motivo de la actividad no realizada:</strong><br>
                <?= nl2br($this->escapeHtml($actividad->motivo_rechazo)) ?>
            </div>
        <?php endif; ?>
    <?php endif; ?>
</div>

<table>
    <thead>
        <tr>
            <th style="width:5%">#</th>
            <th style="width:20%">Carnet</th>
            <th style="width:45%">Nombre completo</th>
            <th style="width:30%">Carrera</th>
        </tr>
    </thead>
    <tbody>
        <?php if (empty($participantes)): ?>
            <tr>
                <td colspan="4" style="text-align:center">
                    No hay estudiantes registrados en esta actividad.
                </td>
            </tr>
        <?php else: ?>
            <?php foreach ($participantes as $i => $p): ?>
                <tr>
                    <td><?= $i + 1 ?></td>
                    <td><?= $this->escapeHtml($p->carnet) ?></td>
                    <td><?= $this->escapeHtml($p->nombre) ?></td>
                    <td><?= $this->escapeHtml($p->carrera_nombre ?? '') ?></td>
                </tr>
            <?php endforeach; ?>
        <?php endif; ?>
    </tbody>
</table>

<br>

<div class="small" style="text-align:center">
    Documento generado automáticamente por el sistema de créditos extracurriculares.
</div>

</body>
</html>
