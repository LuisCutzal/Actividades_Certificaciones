    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Carnet</th>
                    <th>Nombre</th>
                    <?php if ($this->tipo_id === 2): ?>
                        <th>Carrera</th>
                    <?php endif; ?>
                    <th>Estado</th>
                    <th>Acción</th>
                    <?php if (!in_array($this->tipo_id, [2, 3])): ?>
                        <th>Constancia</th>
                    <?php endif; ?>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($this->estudiantes as $e): ?>
                    <tr>
                        <td><?= $this->escapeHtml($e->carnet) ?></td>

                        <td><?= $this->escapeHtml($e->nombre) ?></td>
                        <?php if ($this->tipo_id === 2): ?>
                            <td>
                                <?= $this->escapeHtml($e->nombre_carrera ?? 'Sin carrera') ?>
                            </td>
                        <?php endif; ?>

                        <td>

                            <?php

                            if (!empty($e->fecha_publico) || !empty($e->acta_publico)) {

                                $status = ['Graduado', 'primary'];
                            } elseif (!empty($e->fecha_privado) || !empty($e->acta_privado)) {

                                $status = ['Privado', 'info text-dark'];
                            } elseif (!empty($e->fecha_eps)) {

                                $status = ['EPS', 'warning text-dark'];
                            } elseif (!empty($e->fecha_cierre)) {

                                $status = ['Cerrado', 'warning text-dark'];
                            } else {

                                $status = ['Activo', 'success'];
                            }

                            ?>

                            <!-- Estado académico -->

                            <span class="badge bg-<?= $status[1] ?>">
                                <?= $this->escapeHtml($status[0]) ?>
                            </span>

                            <!-- Estado de inscripción -->

                            <?php if ($e->anio_inscrito): ?>

                                <span class="badge bg-success ms-1">
                                    Inscrito <?= $this->escapeHtml($e->anio_inscrito) ?>
                                </span>

                            <?php else: ?>

                                <span class="badge bg-secondary ms-1">
                                    No inscrito
                                </span>

                            <?php endif; ?>

                        </td>

                        <td class="text-nowrap">
                            <a href="/estudiantes/ver/<?= $e->carnet ?>"
                                class="btn btn-sm btn-outline-primary me-1">
                                👁 Ver
                            </a>

                            <?php if (!in_array($this->tipo_id, [2, 3])): ?>
                                <a href="/reportes/constancias/estudiante/<?= $e->carnet ?>"
                                    class="btn btn-sm btn-primary">
                                    🎓 Historial
                                </a>
                            <?php endif; ?>
                        </td>

                        <?php if (!in_array($this->tipo_id, [2, 3])): ?>
                            <td>
                                <a class="btn btn-sm btn-success"
                                    href="/reportes/auditoria/pdf/estudiante/<?= $e->carnet ?>/aprobadas"
                                    target="_blank">
                                    ✅ Aprobadas
                                </a>
                                <!-- <br><br>
                                <a class="btn btn-sm btn-secondary"
                                    href="/reportes/auditoria/pdf/estudiante/<?= $e->carnet ?>/todas"
                                    target="_blank">
                                    📄 Constancia de Cumplimiento
                                </a>  -->
                            </td>
                        <?php endif; ?>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
        <?= $this->partial('application/partials/pagination', [
