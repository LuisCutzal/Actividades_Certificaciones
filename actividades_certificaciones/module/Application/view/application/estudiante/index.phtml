<div class="container py-4">

    <?php if ($this->flashMessenger()->hasWarningMessages()): ?>
        <?php foreach ($this->flashMessenger()->getWarningMessages() as $msg): ?>
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <?= $this->escapeHtml($msg) ?>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <?php endforeach; ?>
    <?php endif; ?>

    <?php if ($this->flashMessenger()->hasSuccessMessages()): ?>
        <?php foreach ($this->flashMessenger()->getSuccessMessages() as $msg): ?>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <?= $this->escapeHtml($msg) ?>
